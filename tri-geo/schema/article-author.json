[
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": "[REPLACE: 文章 URL + #article]",
    "headline": "[REPLACE: 标题，建议 ≤30 字且含目标问题关键词]",
    "description": "[REPLACE: 80-120 字摘要，须为可独立引用的直答段]",
    "url": "[REPLACE: 文章 URL]",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "[REPLACE: 文章 URL]"
    },
    "image": {
      "@type": "ImageObject",
      "url": "[REPLACE: 题图绝对地址]",
      "width": 1200,
      "height": 675
    },
    "datePublished": "[REPLACE: ISO 8601 首发时间，如 2026-09-15T09:00:00+08:00]",
    "dateModified": "[REPLACE: ISO 8601 更新时间，每次修订 MUST 同步]",
    "author": {
      "@type": "Person",
      "@id": "[REPLACE: 作者页 URL + #person]"
    },
    "publisher": {
      "@type": "Organization",
      "@id": "[REPLACE: 品牌主体 #organization 的 @id，与 organization.json 保持一致]"
    },
    "articleSection": "[REPLACE: 栏目/品类]",
    "inLanguage": "zh-CN",
    "wordCount": "[REPLACE: 正文字数，须为数字]",
    "keywords": "[REPLACE: 逗号分隔关键词]",
    "about": [
      {
        "@type": "Thing",
        "name": "[REPLACE: 实体关键词 1]"
      }
    ],
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["[REPLACE: 直答段 CSS 选择器，如 .geo-direct-answer]", "[REPLACE: 结论段选择器]"]
    },
    "isAccessibleForFree": true
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "[REPLACE: 作者页 URL + #person]",
    "name": "[REPLACE: 作者真实姓名或稳定笔名]",
    "url": "[REPLACE: 作者页 URL]",
    "image": "[REPLACE: 作者头像绝对地址]",
    "jobTitle": "[REPLACE: 职务，须与从业资质相关]",
    "description": "[REPLACE: 30-60 字专业背景简介，须可核验]",
    "worksFor": {
      "@type": "Organization",
      "@id": "[REPLACE: 品牌主体 #organization 的 @id]"
    },
    "knowsAbout": [
      "[REPLACE: 专业领域 1]",
      "[REPLACE: 专业领域 2]",
      "[REPLACE: 专业领域 3]"
    ],
    "alumniOf": {
      "@type": "Organization",
      "name": "[REPLACE: 毕业院校/机构，不便公开则删除本段]"
    },
    "sameAs": [
      "[REPLACE: 知乎个人主页 URL]",
      "[REPLACE: 公众号/CSDN/行业专栏 URL]",
      "[REPLACE: 领英个人页 URL，无则删除]"
    ]
  }
]
