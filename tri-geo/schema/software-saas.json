{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "[REPLACE: 产品页 URL + #software]",
  "name": "[REPLACE: 产品名，须与官网/百科/应用市场完全一致]",
  "alternateName": ["[REPLACE: 别名或旧名，无则删除本行]"],
  "url": "[REPLACE: 产品页 URL]",
  "applicationCategory": "[REPLACE: BusinessApplication | DeveloperApplication | UtilitiesApplication 之一]",
  "applicationSubCategory": "[REPLACE: 细分品类，如 项目管理]",
  "operatingSystem": "[REPLACE: Web / Windows / macOS / Android / iOS，多个用逗号分隔]",
  "description": "[REPLACE: 80-140 字客观描述：解决什么问题 + 核心能力 + 适用对象，禁广告法禁用语]",
  "screenshot": "[REPLACE: 产品截图绝对地址]",
  "softwareVersion": "[REPLACE: 当前版本号，如 2.1.0]",
  "datePublished": "[REPLACE: ISO 8601 首发日期]",
  "dateModified": "[REPLACE: ISO 8601 更新日期]",
  "inLanguage": "zh-CN",
  "publisher": {
    "@type": "Organization",
    "@id": "[REPLACE: 品牌主体 #organization 的 @id]"
  },
  "author": {
    "@type": "Organization",
    "@id": "[REPLACE: 品牌主体 #organization 的 @id]"
  },
  "featureList": [
    "[REPLACE: 核心功能 1]",
    "[REPLACE: 核心功能 2]",
    "[REPLACE: 核心功能 3]"
  ],
  "offers": {
    "@type": "Offer",
    "price": "[REPLACE: 价格数字，免费填 0]",
    "priceCurrency": "CNY",
    "priceValidUntil": "[REPLACE: ISO 8601 日期，如 2027-12-31]",
    "availability": "https://schema.org/InStock",
    "url": "[REPLACE: 定价页 URL]"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "[REPLACE: 真实评分数字，如 4.6]",
    "ratingCount": "[REPLACE: 真实评价条数，须为数字]",
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "[REPLACE: 百度百科词条 URL，无则删除]",
    "[REPLACE: 知乎产品/机构号 URL]",
    "[REPLACE: 应用市场详情页 URL]",
    "[REPLACE: 官网首页 URL]"
  ]
}
