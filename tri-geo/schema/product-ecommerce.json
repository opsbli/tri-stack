{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "[REPLACE: 商品详情页 URL + #product]",
  "name": "[REPLACE: 商品全称，须与包装/详情页标题一致]",
  "alternateName": "[REPLACE: 常用叫法/别名，无则删除本行]",
  "sku": "[REPLACE: 商品编码]",
  "gtin13": "[REPLACE: 69 开头条码，无则删除本行]",
  "brand": {
    "@type": "Brand",
    "name": "[REPLACE: 品牌名，须与 organization.json 的 name 一致]"
  },
  "category": "[REPLACE: 叶子类目路径，如 家用电器 > 空调 > 挂机]",
  "description": "[REPLACE: 80-160 字客观描述：规格参数 + 适用场景 + 差异化事实，禁广告法禁用语与绝对化用语]",
  "image": [
    "[REPLACE: 主图绝对地址]",
    "[REPLACE: 细节图绝对地址]"
  ],
  "url": "[REPLACE: 商品详情页 URL]",
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "[REPLACE: 关键参数名，如 能效等级]",
      "value": "[REPLACE: 参数值]"
    },
    {
      "@type": "PropertyValue",
      "name": "[REPLACE: 关键参数名 2]",
      "value": "[REPLACE: 参数值 2]"
    }
  ],
  "offers": {
    "@type": "Offer",
    "url": "[REPLACE: 商品详情页 URL]",
    "priceCurrency": "CNY",
    "price": "[REPLACE: 售价数字，如 2999.00]",
    "priceValidUntil": "[REPLACE: ISO 8601 日期]",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "@id": "[REPLACE: 品牌主体 #organization 的 @id]"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "[REPLACE: 运费数字，包邮填 0]",
        "currency": "CNY"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 3,
          "unitCode": "DAY"
        }
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "CN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "[REPLACE: 真实评分数字]",
    "reviewCount": "[REPLACE: 真实评价条数，须为数字]",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "[REPLACE: 真实单条评分]",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "[REPLACE: 评价者昵称]"
      },
      "datePublished": "[REPLACE: ISO 8601 日期]",
      "reviewBody": "[REPLACE: 真实评价正文摘录]"
    }
  ]
}
