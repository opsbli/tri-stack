{
  "$schema": "tri-cache-meta-v2",
  "description": "tri-cache 运行时配置模板（四层架构）。首次运行时由 cache_init.py 复制到 .tribro/cache/meta.json，可按需调整。",
  "config": {
    "config_max_size_mb": 100,
    "config_default_ttl_seconds": 2592000,
    "config_window_size": 50,
    "config_window_inject_full_rounds": 2,
    "config_embedding_dim": 256,
    "config_embedding_ngram": [1, 2],
    "config_vector_top_k": 10,
    "config_vector_min_score": 0.5,
    "config_summary_max_chars": 200,
    "config_ttl_by_intent": {
      "I01": 2592000,
      "I02": 2592000,
      "I03": 604800,
      "I04": 604800,
      "I05": 604800,
      "I06": 86400,
      "I07": 86400,
      "I08": 86400,
      "I09": 86400,
      "I10": 86400,
      "I13": 604800,
      "I14": 604800,
      "I15": 86400,
      "I16": 86400
    },
    "config_no_cache_intents": ["I11", "I12", "I17", "I18", "I19", "I20", "M01", "M02", "M03", "M04"],
    "config_reuse_strategy_by_intent": {
      "I01": "direct",
      "I02": "direct",
      "I03": "reference",
      "I04": "reference",
      "I05": "reference",
      "I06": "reference",
      "I07": "reference",
      "I08": "reference",
      "I09": "reference",
      "I10": "reference",
      "I13": "reference",
      "I14": "reference",
      "I15": "reference",
      "I16": "reference"
    },
    "config_privacy_patterns": [
      "password=...",
      "passwd=...",
      "secret=...",
      "api_key=...",
      "api-key=...",
      "token=...",
      "sk-[a-zA-Z0-9]{20,}",
      "AKIA[0-9A-Z]{16}",
      "-----BEGIN.*PRIVATE KEY-----"
    ],
    "config_privacy_redact_threshold": 3,
    "config_sqlite_pragmas": {
      "journal_mode": "WAL",
      "synchronous": "NORMAL",
      "temp_store": "MEMORY",
      "cache_size": -20000
