{
  "schema_version": 1,
  "description": "tri-true 运行时配置模板。首次运行时复制到 .tribro/true/meta.json，可按需调整。",
  "config": {
    "config_default_risk_level": "medium",
    "config_default_domain": "general",
    "config_default_upstream_mode": "C_degraded",
    "config_confidence_thresholds": {
      "low": 0.7,
      "medium": 0.75,
      "high": 0.85,
      "critical": 0.9
    },
    "config_confidence_weights": {
      "vc": 0.4,
      "sc": 0.3,
      "cc": 0.3
    },
    "config_knowledge_types": {
      "known": {
        "name": "事实",
        "routing": "防线二",
        "allow_confidence_pass": true,
        "require_source": true
      },
      "computed": {
        "name": "计算",
        "routing": "重算验证",
        "allow_confidence_pass": false,
        "require_recompute": true
      },
      "inferred": {
        "name": "推断",
        "routing": "防线三+防线四",
        "allow_confidence_pass": false,
        "require_multi_model": true
      },
      "iframe": {
        "name": "框架",
        "routing": "框架一致性验证+防线三",
        "allow_confidence_pass": false,
        "require_framework_check": true
      },
      "common": {
        "name": "常识",
        "routing": "防线一",
        "allow_confidence_pass": true,
        "require_source": false
      },
      "guess": {
        "name": "猜测",
        "routing": "四道防线全走+人审兜底",
        "allow_confidence_pass": false,
        "require_human_review": true
      }
    },
    "config_source_weights": {
      "relevance": 0.4,
      "credibility": 0.4,
      "freshness": 0.2
    },
    "config_source_tier_credibility": {
      "T1": 1.0,
      "T2": 0.8,
      "T3": 0.5,
      "T4": 0.2
    },
    "config_consensus_thresholds": {
      "strong_consensus": 1.0,
      "weak_consensus_ratio": 0.667,
      "all_confident_min": 0.7
    },
    "config_heterogeneous_requirements": {
      "min_models": 3,
      "min_vendors": 2,
      "min_open_source": 1,
      "min_families": 2
    },
    "config_max_revision_rounds": 3,
    "config_revision_methods": ["cove", "reflexion", "critique_refine"],
    "config_self_consistency_samples": 5,
    "config_max_model_calls_per_task": 5,
    "config_cost_alert_threshold": 0.5,
    "config_idk_threshold": 0.5,
    "config_human_review_threshold": 0.8,
    "config_high_risk_operations": ["delete", "publish", "fund_transfer", "production_deploy"],
    "config_privacy_scan_patterns": [
      "api_key",
      "password",
      "secret",
      "token",
      "private_key",
      "credit_card",
      "ssn",
      "email",
      "phone"
    ],
    "config_privacy_max_sensitive_hits": 3,
    "config_require_citation": true,
    "config_allow_human_review": true,
    "config_enable_cache": false,
    "config_sources_path": "sources.json",
    "config_calibration_path": "calibration.json",
    "config_models_path": "models.json",
    "config_max_input_chars": 50000,
    "config_avg_latency_targets": {
      "low_risk_ms": 30000,
      "high_risk_ms": 120000
    },
    "config_quality_targets": {
      "hallucination_detection_rate_min": 0.85,
      "hallucination_reduction_rate_min": 0.5,
      "false_positive_rate_max": 0.1,
      "ece_max": 0.15,
      "citation_accuracy_min": 0.9,
      "revision_closure_rate_min": 0.8
    }
  },
  "stats": {
    "total_verifications": 0,
    "verified_count": 0,
    "rejected_count": 0,
    "uncertain_count": 0,
    "human_review_count": 0,
    "avg_confidence": 0,
    "avg_latency_ms": 0,
    "防线一_trigger_rate": 0,
    "防线二_trigger_rate": 0,
    "防线三_trigger_rate": 0,
    "防线四_trigger_rate": 0,
    "total_model_calls": 0,
    "total_cost": 0,
    "last_verification_at": null
  }
}
